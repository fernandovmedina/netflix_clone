POSTGRES_USER=netflix
POSTGRES_PASSWORD=replace-with-a-strong-local-password
POSTGRES_DB=netflix
DATABASE_URL=postgres://netflix:replace-with-a-strong-local-password@postgres:5432/netflix?sslmode=disable

JWT_SECRET=replace-with-at-least-32-random-bytes
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
COOKIE_SECURE=false

GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback

FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
CATALOG_SERVICE_URL=http://nginx:8081/catalog
STREAMING_SERVICE_URL=http://nginx:8081/streaming
USER_SERVICE_URL=http://nginx:8081/user

MEDIA_ROOT=/media
MAX_UPLOAD_BYTES=5368709120
ADMIN_EMAIL=admin@netflix.local
ADMIN_PASSWORD=replace-with-a-local-admin-password

NEXT_PUBLIC_API_URL=http://localhost:8080
