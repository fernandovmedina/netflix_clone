# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (the root template is intentionally committed)
.env*
!/.env.example
.env.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# mcp
.mcp.json

# local configuration files and directories
supabase/

# generated media (scope segments so TypeScript source remains tracked)
/media/
/media/**/*.ts
*.m3u8
/.pnpm-store/

# local seed video. Only code belongs in the repository: a fresh clone seeds the
# catalog with metadata and artwork but no video, and an administrator uploads
# clips through /admin to start testing. See seed/video/README.md.
/seed/video/*.mp4
/seed/video/*.mov
/seed/video/*.mkv
/seed/video/*.webm

# Compiled Go service binaries (produced by `go build ./...` in a module dir)
/microservices/auth/auth
/microservices/catalog/catalog
/microservices/streaming/streaming
/microservices/user/user
/microservices/worker/worker
/database/seed/seed
